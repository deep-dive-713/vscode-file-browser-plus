{
    "name": "file-browser-plus",
    "publisher": "deep-dive-713",
    "displayName": "File Browser Plus",
    "description": "A keyboard driven file open dialog with dired-like details: permissions, sizes, link targets, chmod, new folders and folder sizes. Fork of bodil.file-browser.",
    "version": "0.3.0",
    "license": "LGPL-3.0+",
    "author": {
        "name": "deep-dive-713"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/deep-dive-713/vscode-file-browser-plus"
    },
    "keywords": [
        "emacs",
        "helm",
        "dired",
        "file browser",
        "chmod",
        "permissions"
    ],
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.75"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "extensionKind": [
        "workspace",
        "ui"
    ],
    "contributes": {
        "configuration": {
            "title": "File Browser Plus",
            "properties": {
                "file-browser-plus.removeIgnoredFiles": {
                    "markdownDescription": "Never show or match files that are hidden when matching by either `#file-browser-plus.hideIgnoredFiles#` or `#file-browser-plus.hideDotfiles#`.",
                    "type": "boolean",
                    "default": false
                },
                "file-browser-plus.hideDotfiles": {
                    "markdownDescription": "When filtering by name, hide unmatched dotfiles (files whose names start with `.`).",
                    "type": "boolean",
                    "default": true
                },
                "file-browser-plus.hideIgnoredFiles": {
                    "markdownDescription": "When filtering by name, hide unmatched files according to rules in `.gitignore` style files, as defined in `#file-browser-plus.ignoreFileTypes#`.",
                    "type": "boolean",
                    "default": false
                },
                "file-browser-plus.labelIgnoredFiles": {
                    "markdownDescription": "Label files hidden by a `.gitignore` file as such.",
                    "type": "boolean",
                    "default": false
                },
                "file-browser-plus.ignoreFileTypes": {
                    "markdownDescription": "A list of `.gitignore` style files to look for and hide files accordingly when browsing. The extension will obey only the first file it finds from this list, searching upwards from the current directory, so make sure the order is as you like it.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        ".gitignore",
                        ".npmignore",
                        ".vscodeignore"
                    ]
                },
                "file-browser-plus.showPermissions": {
                    "markdownDescription": "Show permissions such as `drwxr-xr-x` next to each entry. Ignored on Windows.",
                    "type": "boolean",
                    "default": true
                },
                "file-browser-plus.showSize": {
                    "markdownDescription": "Show the size of each file next to it (like `ls -lh`). Folder sizes are only calculated on request, from the actions of a folder.",
                    "type": "boolean",
                    "default": true
                },
                "file-browser-plus.showLinkTarget": {
                    "markdownDescription": "Show where each symbolic link points to.",
                    "type": "boolean",
                    "default": true
                },
                "file-browser-plus.folderSizeTimeLimit": {
                    "markdownDescription": "Stop calculating a folder size after this many seconds and show the partial result. `0` means no limit.",
                    "type": "number",
                    "default": 10,
                    "minimum": 0
                }
            }
        },
        "commands": [
            {
                "command": "file-browser-plus.open",
                "title": "File Browser Plus: Open"
            },
            {
                "command": "file-browser-plus.rename",
                "title": "File Browser Plus: Rename"
            },
            {
                "command": "file-browser-plus.stepIn",
                "title": "File Browser Plus: Step In"
            },
            {
                "command": "file-browser-plus.stepOut",
                "title": "File Browser Plus: Step Out"
            },
            {
                "command": "file-browser-plus.actions",
                "title": "File Browser Plus: Actions"
            },
            {
                "command": "file-browser-plus.openToSide",
                "title": "File Browser Plus: Open to the Side"
            },
            {
                "command": "file-browser-plus.newFolder",
                "title": "File Browser Plus: New Folder"
            }
        ],
        "keybindings": [
            {
                "key": "right",
                "command": "file-browser-plus.stepIn",
                "when": "inFileBrowserPlus"
            },
            {
                "key": "left",
                "command": "file-browser-plus.stepOut",
                "when": "inFileBrowserPlus"
            },
            {
                "key": "ctrl+a",
                "command": "file-browser-plus.actions",
                "when": "inFileBrowserPlus"
            },
            {
                "key": "tab",
                "command": "file-browser-plus.tabNext",
                "when": "inFileBrowserPlus"
            },
            {
                "key": "shift+tab",
                "command": "file-browser-plus.tabPrev",
                "when": "inFileBrowserPlus"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint src",
        "watch": "tsc -watch -p ./",
        "check": "npm run compile && npm run lint",
        "package": "vsce package --no-dependencies"
    },
    "devDependencies": {
        "@eslint/js": "^9.11.1",
        "@types/eslint__js": "^8.42.3",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.8",
        "@types/node": "^22.7.4",
        "@types/vscode": "1.75.1",
        "@typescript-eslint/eslint-plugin": "^8.8.0",
        "@typescript-eslint/parser": "^8.8.0",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^9.11.1",
        "glob": "^11.0.0",
        "mocha": "^10.7.3",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.8.0"
    },
    "dependencies": {
        "@bodil/opt": "^0.2.5",
        "ignore": "^6.0.2"
    },
    "contributors": [
        {
            "name": "Bodil Stokke",
            "url": "https://bodil.lol/"
        }
    ],
    "bugs": {
        "url": "https://github.com/deep-dive-713/vscode-file-browser-plus/issues"
    },
    "activationEvents": [
        "onStartupFinished"
    ]
}
